{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "boundary"], "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "if": "Bash(git *)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "secret"], "timeout": 20, "onFailure": "block" }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          { "type": "command", "if": "PowerShell(git *)", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "secret"], "timeout": 20, "onFailure": "block" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "prompt"], "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "compact"], "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/run.mjs", "stop"], "timeout": 20 }
        ]
      }
    ]
  }
}
